<mujoco model="layout">

  <option timestep="0.005" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.4 0.4 0.4" diffuse="0.6 0.6 0.6"/>
    <global offwidth="1280" offheight="720"/>
  </visual>


  <default>
    <!-- Visual-only markers: nothing collides with them -->
    <default class="marker">
      <geom type="box" contype="0" conaffinity="0" group="2" rgba="0.08 0.20 0.50 0.15"/>
      <default class="stash">
        <geom rgba="0.18 0.40 0.22 0.3"/>
      </default>
      <default class="bounds">
        <geom rgba="0.5 0.5 0.5 0.05"/>
      </default>
    </default>
    <default class="material">
      <geom type="box" size="0.1 0.1 0.1" mass="1" rgba="0.22 0.22 0.24 1"/>
    </default>
  </default>

  <worldbody>
    <light name="sun" pos="0 0 10" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.45 0.45 0.45 1"/>

    <!-- Rover defined here rather than via rover.xml, whose start pose is for the full site.
         Starts at the arena centre, between the pile and the pad, facing north (+y). -->
    <body name="rover" mocap="true" pos="0 0 0.08" quat="0.7071068 0 0 0.7071068">
      <geom name="chassis" type="box" size="0.3 0.2 0.08" rgba="0.85 0.85 0.8 1"/>
      <!-- red nose marks the front -->
      <geom name="nose" type="box" size="0.04 0.04 0.02" pos="0.3 0 0.08"
            contype="0" conaffinity="0" rgba="0.9 0.2 0.2 1"/>
    </body>

    <!-- The env reads these three geoms by name, so sizes/positions live only here. -->

    <!-- Arena: rover is kept inside x, y in [-3, 3] -->
    <geom name="arena" class="bounds" pos="0 0 0.001" size="3 3 0.001"/>

    <!-- Material pile (west): x in [-2.7, -0.9], y in [-0.8, 0.8] -->
    <geom name="material_zone" class="stash" pos="-1.8 0 0.002" size="0.9 0.8 0.001"/>

    <!-- Target landing pad (east): 1.0 x 0.6 m = 5 x 3 tiles of 0.2 m.
         x in [1.3, 2.3], y in [-0.3, 0.3] -->
    <geom name="target_pad" class="marker" pos="1.8 0 0.002" size="0.5 0.3 0.001"/>

    <camera name="overview" pos="0 -6 6" xyaxes="1 0 0 0 0.707 0.707"/>

    <!-- Materials: 5 x 4 = 20 blocks (0.2 m cubes) on a 0.4 m grid in material_zone.
         20 blocks for 15 tiles leaves ~33% spare for wasted drops. -->
    <replicate count="4" offset="0 0.4 0" sep="_">
      <replicate count="5" offset="0.4 0 0" sep="_">
        <body name="mat" pos="-2.6 -0.6 0.1"><freejoint/><geom class="material"/></body>
      </replicate>
    </replicate>
  </worldbody>
</mujoco>